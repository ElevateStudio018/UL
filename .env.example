# Kopiera till .env och fyll i. Utan värden startar appen i demoläge.

# Webbläsarnyckel för Google Maps JavaScript API, Places API (New) och Geocoding API.
# Begränsa nyckeln till appens domäner (HTTP-referenter) och till just dessa API:er.
GOOGLE_MAPS_BROWSER_KEY=
# Valfritt kart-id (Map ID) från Google Cloud Console.
GOOGLE_MAP_ID=

# OpenTripPlanner 2 (GTFS GraphQL API), se otp/README.md.
OTP_URL=
OTP_FEED_ID=ul

# Trafiklab: GTFS Regional Realtime för UL (hemlig, används bara på servern).
TRAFIKLAB_GTFS_RT_KEY=
# Trafiklab: GTFS Regional Static för UL (används av otp/download.sh när grafen byggs).
TRAFIKLAB_GTFS_STATIC_KEY=

PORT=8787
